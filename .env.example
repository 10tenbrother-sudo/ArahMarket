# APP_SECRET: kunci penandatanganan token sesi (WAJIB di production).
# Generate dengan: openssl rand -hex 32
APP_SECRET="ganti-dengan-hasil-openssl-rand-hex-32"

# GEMINI_API_KEY: dibutuhkan untuk pemanggilan Gemini AI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL tempat aplikasi ini di-host.
APP_URL="http://localhost:3000"

# MIDTRANS PAYMENT GATEWAY (Indonesia - QRIS & Mandiri Bill / Virtual Account)
# Dapatkan di: https://dashboard.midtrans.com/ (Menu Settings -> Access Keys)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# EMAIL VERIFICATION SERVICE (Gmail App Password)
# Opsional: Jika dikosongkan, aktivasi berjalan otomatis via link langsung di layar registrasi.
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"

